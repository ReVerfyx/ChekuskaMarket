[Unit]
Description=FunPay gift completion notifier
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=funpay
WorkingDirectory=/opt/funpay-assistant
EnvironmentFile=/opt/funpay-assistant/.env
ExecStart=/opt/funpay-assistant/.venv/bin/python /opt/funpay-assistant/bot.py gift-notifier
Restart=always
RestartSec=15
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/funpay-assistant/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
