[Unit]
Description=ChekuskaMarket autonomous FunPay publisher and lot auto-raise
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=funpay
Group=funpay
WorkingDirectory=/opt/chekuska-market
EnvironmentFile=/opt/chekuska-market/.env
ExecStart=/opt/chekuska-market/.venv/bin/python /opt/chekuska-market/autoseller.py loop
Restart=always
RestartSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/chekuska-market/data

[Install]
WantedBy=multi-user.target
