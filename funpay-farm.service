[Unit]
Description=Seller-owned account game worker queue
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=funpay
WorkingDirectory=/opt/funpay-assistant
ExecStart=/opt/funpay-assistant/.venv/bin/python /opt/funpay-assistant/farm.py loop
Restart=always
RestartSec=15
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/funpay-assistant/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
